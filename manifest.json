{
  "manifest_version": 3,
  "name": "Fleet Side Panel Scraper",
  "version": "3.0",
  "description": "Advanced vehicle data scraper with coordinates and location.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "downloads",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://dash.packzy.com/*",
    "https://nominatim.openstreetmap.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Fleet Scraper"
  }
}